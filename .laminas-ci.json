{
    "additional_composer_arguments": [
        "--ignore-platform-req=php"
    ],
    "additional_checks": [
        {
            "name": "PHP CS Fixer",
            "job": {
                "php": "8.5",
                "dependencies": "latest",
                "command": "composer require --dev --ignore-platform-req=php friendsofphp/php-cs-fixer && vendor/bin/php-cs-fixer check"
            }
        },
        {
            "name": "PhpStan",
            "job": {
                "php": "8.5",
                "dependencies": "latest",
                "command": "composer require --dev --ignore-platform-req=php phpstan/phpstan && vendor/bin/phpstan analyse"
            }
        }
    ]
}