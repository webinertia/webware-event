{
    "name": "webware/webware-event",
    "description": "Event system for Webware",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "event",
        "dispatcher",
        "PSR-14"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "phly/phly-event-dispatcher": "^1.5.0",
        "webmozart/assert": "^1.11.0 || ^2.0.0",
        "webware/webware-core": "^1.0.0-alpha.1"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.3.0",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/webware-tools": "^1.0.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Webware\\Event\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\Event\\": "test/unit/",
            "WebwareTestIntegration\\Event\\": "test/integration/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": true
        }
    },
    "scripts": {
        "test-all": [
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-html coverage/html --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection"
    }
}